generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URI")
}

model User {
  id String @id @default(cuid())

  provider   String?
  providerId String?

  tagName String @unique

  email    String  @unique
  password String?
  role     Role    @default(USER)

  firstName String?
  lastName  String?
  phone     String?
  avatar    String?
  currency  Currency @default(USD)

  debts                Debt[]    @relation("UserDebts")
  counterpartyDebts    Debt[]    @relation("DebtCounterparty")
  lendings             Lending[] @relation("UserLendings")
  counterpartyLendings Lending[] @relation("LendingCounterparty")

  transactions           Transaction[] @relation("UserTransactions")
  approvableTransactions Transaction[] @relation("TransactionApprover")
  initiatedTransactions  Transaction[] @relation("TransactionInitiator")

  receivedNotifications Notification[] @relation("UserNotifications")
  sentNotifications     Notification[] @relation("NotificationActor")

  payments   Payment[]
  sessions   Session[]
  categories Category[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Transaction {
  id   String          @id @default(cuid())
  type TransactionType

  name        String?
  description String?
  status      Status  @default(PENDING)

  amount  Amount?  @relation("TransactionToAmount")
  dueDate DateTime

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  ownerId String
  owner   User   @relation("UserTransactions", fields: [ownerId], references: [id])

  linkedTransactionId String?      @unique
  linkedTransaction   Transaction? @relation("TransactionLink", fields: [linkedTransactionId], references: [id])
  mirrorTransaction   Transaction? @relation("TransactionLink")

  initiatorId String
  approverId  String?
  initiator   User    @relation("TransactionInitiator", fields: [initiatorId], references: [id])
  approver    User?   @relation("TransactionApprover", fields: [approverId], references: [id])

  debt    Debt?    @relation("TransactionToDebt")
  lending Lending? @relation("TransactionToLending")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Debt {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation("TransactionToDebt", fields: [transactionId], references: [id], onDelete: Cascade)

  borrowerId String
  borrower   User   @relation("UserDebts", fields: [borrowerId], references: [id])

  counterpartyId String
  counterparty   User   @relation("DebtCounterparty", fields: [counterpartyId], references: [id])

  payments Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Lending {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation("TransactionToLending", fields: [transactionId], references: [id], onDelete: Cascade)

  lenderId String
  lender   User   @relation("UserLendings", fields: [lenderId], references: [id])

  counterpartyId String
  counterparty   User   @relation("LendingCounterparty", fields: [counterpartyId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Payment {
  id String @id @default(cuid())

  amount Amount? @relation("PaymentToAmount")

  debtId String
  debt   Debt   @relation(fields: [debtId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Amount {
  id String @id @default(cuid())

  value    Float
  currency Currency

  transactionId String?      @unique
  transaction   Transaction? @relation("TransactionToAmount", fields: [transactionId], references: [id], onDelete: Cascade)

  paymentId String?  @unique
  payment   Payment? @relation("PaymentToAmount", fields: [paymentId], references: [id], onDelete: Cascade)
}

model Category {
  id    String @id @default(cuid())
  title String
  icon  String

  type CategoryType

  transactions Transaction[]

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, title])
}

model Session {
  id String @id @default(cuid())

  csrfSecret String?
  token      String  @unique

  fingerprint String

  expire    DateTime
  rotatedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Session")
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id])

  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id])

  type NotificationType

  transactionId String?
  paymentId     String?

  data Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, readAt])
  @@index([transactionId])
  @@index([paymentId])
}

enum NotificationType {
  TRANSACTION_CREATED
  TRANSACTION_ACCEPTED
  TRANSACTION_REJECTED
  PAYMENT_ADDED
  TRANSACTION_PAID
}

enum CategoryType {
  SYSTEM
  CUSTOM
}

enum TransactionType {
  DEBT
  LENDING
}

enum Currency {
  AZN
  EUR
  USD
}

enum Status {
  PENDING
  ACCEPTED
  REJECTED
  PAID
  OVERDUE
}

enum Role {
  ADMIN
  USER
}
