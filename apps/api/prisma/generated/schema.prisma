generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URI")
}

model User {
  id String @id @default(cuid())

  provider   String?
  providerId String?

  tagName String @unique

  email    String  @unique
  password String?
  role     Role    @default(USER)

  firstName String?
  lastName  String?
  phone     String?
  avatar    String?
  currency  Currency @default(USD)

  debts    Debt[]    @relation("UserDebts")
  lendings Lending[] @relation("UserLendings")

  payments   Payment[]
  sessions   Session[]
  categories Category[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Debt {
  id          String   @id @default(cuid())
  name        String?
  description String?
  payDate     DateTime
  status      Status   @default(PENDING)

  amount Amount? @relation("DebtToAmount")

  categoryId String
  category   Category @relation("CategoryDebts", fields: [categoryId], references: [id])

  userId String
  user   User   @relation("UserDebts", fields: [userId], references: [id])

  lending Lending? @relation("DebtToLending")

  payments Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Lending {
  id          String   @id @default(cuid())
  name        String?
  description String?
  dueDate     DateTime
  status      Status   @default(PENDING)

  amount Amount? @relation("LendingToAmount")

  categoryId String
  category   Category @relation("CategoryLendings", fields: [categoryId], references: [id])

  userId String
  user   User   @relation("UserLendings", fields: [userId], references: [id])

  debtId String @unique
  debt   Debt?  @relation("DebtToLending", fields: [debtId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Payment {
  id String @id @default(cuid())

  amount Amount? @relation("PaymentToAmount")

  debtId String
  debt   Debt   @relation(fields: [debtId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Amount {
  id String @id @default(cuid())

  value    Float
  currency Currency

  debtId String? @unique
  debt   Debt?   @relation("DebtToAmount", fields: [debtId], references: [id], onDelete: Cascade)

  lendingId String?  @unique
  lending   Lending? @relation("LendingToAmount", fields: [lendingId], references: [id], onDelete: Cascade)

  paymentId String?  @unique
  payment   Payment? @relation("PaymentToAmount", fields: [paymentId], references: [id], onDelete: Cascade)
}

model Category {
  id       String       @id @default(cuid())
  title    String       @unique
  icon     String
  debts    Debt[]       @relation("CategoryDebts")
  lendings Lending[]    @relation("CategoryLendings")
  type     CategoryType

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

enum CategoryType {
  SYSTEM
  CUSTOM
}

model Contact {
  id    String  @id @default(cuid())
  phone String
  email String?
}

model Session {
  id String @id @default(cuid())

  isAuthenticated Boolean
  expire          DateTime
  csrfSecret      String?

  metadata Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Session")
}

enum Currency {
  AZN
  EUR
  USD
}

enum Status {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum Role {
  ADMIN
  USER
}
